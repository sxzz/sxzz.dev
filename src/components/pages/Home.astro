---
import { getEntry, render } from 'astro:content'
import { getAuthorSchema } from '../../data/site'
import { getPageCopy } from '../../i18n/pages'
import { useTranslatedPath, useTranslations, type Lang } from '../../i18n/utils'
import Layout from '../../layouts/Layout.astro'
import { formatDate, getRecentEntries } from '../../utils/content'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const copy = getPageCopy('home', lang)
const t = useTranslations(lang)
const translatePath = useTranslatedPath(lang)
const { Content } = await render((await getEntry('pages', `home/${lang}`))!)
const recent = await getRecentEntries(lang)
const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: copy.schema.name,
  url: copy.schema.url,
  author: getAuthorSchema(lang, {
    includeAlternate: true,
    includeSameAs: true,
  }),
}
---

<Layout title={copy.title} description={copy.description}>
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(schema)}
  />
  <main class="flex flex-1 items-center justify-center px-6 py-12 md:px-12">
    <div class="max-w-xl w-full space-y-10">
      <header
        class="fade-in-up flex items-center gap-5"
        style="animation-delay: 80ms"
      >
        <picture>
          <source srcset={copy.avatar.avif} type="image/avif" />
          <img
            src={copy.avatar.fallback}
            alt={copy.name}
            class="h-20 w-20 rounded-full object-cover shadow-lg shadow-stone-400/10 ring-2 ring-stone-200/80 md:h-24 md:w-24 dark:shadow-black/20 dark:ring-stone-700/50"
          />
        </picture>

        <div>
          <h1
            class:list={[
              'text-3xl md:text-4xl font-700 tracking-tight text-stone-900 dark:text-white leading-tight',
              copy.nameSerif && 'font-serif',
            ]}
          >
            {copy.name}
          </h1>
          <p class="mt-1.5 text-sm text-stone-500 dark:text-stone-400">
            {copy.tagline}
          </p>
        </div>
      </header>

      <div
        class:list={[
          'home-intro fade-in-up text-stone-700 font-serif space-y-4 dark:text-stone-300',
          lang === 'zh' ? 'text-lg leading-loose' : 'text-xl leading-relaxed',
        ]}
        style="animation-delay: 160ms"
      >
        <Content />
      </div>

      <section class="fade-in-up" style="animation-delay: 240ms">
        <h2 class="mb-1 text-xs text-stone-500 tracking-wide dark:text-stone-400">
          {t('home.recent')}
        </h2>
        <ul>
          {recent.map((entry) => (
            <li>
              <a
                href={translatePath(entry.href)}
                class="group flex items-baseline justify-between gap-4 py-2"
              >
                <span
                  class="text-stone-800 font-serif transition-colors duration-200 dark:text-stone-200 group-hover:text-accent dark:group-hover:text-accent-dark"
                >
                  {entry.title}
                </span>
                <time
                  datetime={entry.date.toISOString()}
                  class="shrink-0 text-xs text-stone-500 tabular-nums dark:text-stone-400"
                >
                  {formatDate(entry.date, lang)}
                </time>
              </a>
            </li>
          ))}
        </ul>
      </section>
    </div>
  </main>
</Layout>

<style is:global>
.home-intro a {
  color: inherit;
  text-decoration: underline;
  text-decoration-thickness: 1px;
  text-underline-offset: 0.2em;
  text-decoration-color: var(--prose-accent);
  transition: color 0.2s;
}
.home-intro a:hover {
  color: var(--prose-accent);
}
</style>
