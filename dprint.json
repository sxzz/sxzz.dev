{
  "includes": ["**/*.{ts,tsx,js,jsx,json,md,astro}"],
  "excludes": [
    "node_modules",
    "dist",
    ".astro",
    "pnpm-lock.yaml",
    "**/CHANGELOG*.md"
  ],
  "plugins": [
    "npm:@dprint/typescript",
    "npm:@dprint/json",
    "npm:@dprint/markdown",
    "npm:dprint-plugin-markup",
    "npm:dprint-plugin-malva"
  ],
  "lineWidth": 80,
  "typescript": {
    "semiColons": "asi",
    "quoteStyle": "preferSingle",
    "trailingCommas": "onlyMultiLine",
    "module.sortImportDeclarations": "maintain",
    "module.sortExportDeclarations": "maintain",
    "importDeclaration.sortNamedImports": "maintain"
  }
}
